# Kraken API Configuration
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here
KRAKEN_API_URL=https://api.kraken.com

# Trading Configuration
TRADING_MODE=paper
# Options: paper, live, backtest

# Default Crypto Pairs (comma-separated)
# Supported: BTC_USD, ETH_USD, SOL_USD, XRP_USD, ADA_USD, DOT_USD, DOGE_USD, LINK_USD, LTC_USD, AVAX_USD
CRYPTO_PAIRS=BTC_USD,ETH_USD

# Risk Management
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.05
DEFAULT_STOP_LOSS_PERCENT=2
DEFAULT_TAKE_PROFIT_PERCENT=4
MAX_POSITION_SIZE=1

# Strategy Weights (must sum to 1.0)
WEIGHT_MA_CROSSOVER=0.25
WEIGHT_RSI=0.25
WEIGHT_MACD=0.25
WEIGHT_BOLLINGER=0.25

# Notification Settings
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=your_email@gmail.com

ENABLE_WEBHOOK_ALERTS=false
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Dashboard
DASHBOARD_PORT=3000

# Logging
LOG_LEVEL=info
