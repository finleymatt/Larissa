# OANDA API Configuration
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_API_URL=https://api-fxpractice.oanda.com
# Use https://api-fxtrade.oanda.com for live trading

# Trading Configuration
TRADING_MODE=paper
# Options: paper, live, backtest

# Default Currency Pairs (comma-separated)
CURRENCY_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD

# Risk Management
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.05
DEFAULT_STOP_LOSS_PIPS=50
DEFAULT_TAKE_PROFIT_PIPS=100

# Strategy Weights (must sum to 1.0)
WEIGHT_MA_CROSSOVER=0.25
WEIGHT_RSI=0.25
WEIGHT_MACD=0.25
WEIGHT_BOLLINGER=0.25

# Notification Settings
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL=your_email@gmail.com

ENABLE_WEBHOOK_ALERTS=false
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Dashboard
DASHBOARD_PORT=3000

# Logging
LOG_LEVEL=info
