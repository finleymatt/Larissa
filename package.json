{
  "name": "larissa-forex-trading-bot",
  "version": "1.0.0",
  "description": "A full-suite Forex trading bot with multi-strategy support, backtesting, and performance dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "trade": "npx ts-node src/index.ts trade --mode live",
    "paper": "npx ts-node src/index.ts trade --mode paper",
    "backtest": "npx ts-node src/index.ts backtest",
    "dashboard": "npx ts-node src/index.ts dashboard",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "technicalindicators": "^3.1.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "keywords": ["forex", "trading", "bot", "oanda", "backtesting"],
  "license": "MIT"
}
